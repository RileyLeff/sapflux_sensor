    c_41 = new YAGEO_CC0603KRX7R9BB104_package
    c_42 = new YAGEO_CC0603KRX7R9BB104_package
    c_43 = new YAGEO_CC0603KRX7R9BB104_package
    c_44 = new YAGEO_CC0603KRX7R9BB104_package
    c_45 = new YAGEO_CC0603KRX7R9BB104_package
    c_46 = new YAGEO_CC0603KRX7R9BB104_package
    c_47 = new YAGEO_CC0603KRX7R9BB104_package
    c_48 = new YAGEO_CC0603KRX7R9BB104_package

    # --- 48 protected nodes ---
    prot_1 = new Electrical
    prot_2 = new Electrical
    prot_3 = new Electrical
    prot_4 = new Electrical
    prot_5 = new Electrical
    prot_6 = new Electrical
    prot_7 = new Electrical
    prot_8 = new Electrical
    prot_9 = new Electrical
    prot_10 = new Electrical
    prot_11 = new Electrical
    prot_12 = new Electrical
    prot_13 = new Electrical
    prot_14 = new Electrical
    prot_15 = new Electrical
    prot_16 = new Electrical
    prot_17 = new Electrical
    prot_18 = new Electrical
    prot_19 = new Electrical
    prot_20 = new Electrical
    prot_21 = new Electrical
    prot_22 = new Electrical
