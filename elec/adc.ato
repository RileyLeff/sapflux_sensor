"""
ADC front-end: 1x ADS1115 + 3x 74HC4067 mux + 49-channel input protection.

v1.1: Redesigned for 48 thermistor channels via 3 analog multiplexers.
Each mux selects 1 of 16 thermistor inputs and routes it to a shared
ADC AIN0 input. Only one mux is enabled at a time.

Signal path per thermistor:
  Connector pin → [TVS ESD pin] → R (1k) → [C 100nF to GND] → Mux Y input
  Mux Z output → ADC AIN0

Excitation sense:
  Filtered exc → [TVS] → R (1k) → [C 100nF to GND] → ADC AIN1

ESD rail isolation:
  V3V3 (clean) → L3 (ferrite 600Ω@100MHz) → V3V3_TVS (dirty)
  All 13 TVS arrays' VCC connects to dirty side only.

Mux assignments:
  Mux A: Y0-Y15 = thermistor 1-16 (PA9 = ~E)
  Mux B: Y0-Y15 = thermistor 17-32 (PA10 = ~E)
  Mux C: Y0-Y15 = thermistor 33-48 (PA11 = ~E)
  Shared: PD0-PD3 = S0-S3

ADC1 (0x48): AIN0 = mux Z, AIN1 = excitation sense, AIN2/3 = AGND
"""

#pragma experiment("BRIDGE_CONNECT")

import Resistor
import ElectricPower
import Electrical

from "atopile/ti-ads1115/ti-ads1115.ato" import TI_ADS1115
from "parts/Nexperia_74HC4067PW_118/Nexperia_74HC4067PW_118.ato" import Nexperia_74HC4067PW_118_package
from "parts/TECH_PUBLIC_PRTR5V0U4D_TP/TECH_PUBLIC_PRTR5V0U4D_TP.ato" import TECH_PUBLIC_PRTR5V0U4D_TP_package
from "parts/YAGEO_CC0603KRX7R9BB104/YAGEO_CC0603KRX7R9BB104.ato" import YAGEO_CC0603KRX7R9BB104_package
from "parts/Samsung_Electro_Mechanics_CL10A105KB8NNNC/Samsung_Electro_Mechanics_CL10A105KB8NNNC.ato" import Samsung_Electro_Mechanics_CL10A105KB8NNNC_package
from "parts/Sunlord_GZ1608D601TF/Sunlord_GZ1608D601TF.ato" import Sunlord_GZ1608D601TF_package

module ADCFrontEnd:
    """
    Single ADS1115 + 3x 74HC4067 mux + 49-channel input protection
    (48 thermistors + 1 excitation sense) with ESD rail isolation.
    """

    # --- External interfaces ---
    power = new ElectricPower
    """3.3V supply (clean side — MCU, ADC, muxes)."""

    sda = new Electrical
    scl = new Electrical
    excitation_gpio = new Electrical
    excitation_out = new Electrical
    alert1 = new Electrical

    # Mux control (exposed for MCU GPIO wiring)
    mux_s0 = new Electrical
    mux_s1 = new Electrical
    mux_s2 = new Electrical
    mux_s3 = new Electrical
    mux_en_a = new Electrical
    mux_en_b = new Electrical
    mux_en_c = new Electrical

    # 48 thermistor inputs (from connector)
    therm_1 = new Electrical
    therm_2 = new Electrical
    therm_3 = new Electrical
    therm_4 = new Electrical
    therm_5 = new Electrical
    therm_6 = new Electrical
    therm_7 = new Electrical
    therm_8 = new Electrical
    therm_9 = new Electrical
    therm_10 = new Electrical
    therm_11 = new Electrical
    therm_12 = new Electrical
    therm_13 = new Electrical
    therm_14 = new Electrical
    therm_15 = new Electrical
    therm_16 = new Electrical
    therm_17 = new Electrical
    therm_18 = new Electrical
    therm_19 = new Electrical
    therm_20 = new Electrical
    therm_21 = new Electrical
    therm_22 = new Electrical
    therm_23 = new Electrical
    therm_24 = new Electrical
    therm_25 = new Electrical
    therm_26 = new Electrical
    therm_27 = new Electrical
    therm_28 = new Electrical
    therm_29 = new Electrical
    therm_30 = new Electrical
    therm_31 = new Electrical
    therm_32 = new Electrical
    therm_33 = new Electrical
    therm_34 = new Electrical
    therm_35 = new Electrical
    therm_36 = new Electrical
    therm_37 = new Electrical
    therm_38 = new Electrical
    therm_39 = new Electrical
    therm_40 = new Electrical
    therm_41 = new Electrical
    therm_42 = new Electrical
    therm_43 = new Electrical
    therm_44 = new Electrical
    therm_45 = new Electrical
    therm_46 = new Electrical
    therm_47 = new Electrical
    therm_48 = new Electrical

    # =====================================================================
    # ADC (single ADS1115 at 0x48)
    # =====================================================================
    adc1 = new TI_ADS1115
    power ~ adc1.power
    sda ~ adc1.i2c.sda.line
    scl ~ adc1.i2c.scl.line
    alert1 ~ adc1.alert_ready.line

    # Unused ADC inputs tied to AGND through 1k (prevent noise coupling)
    r_ain2_gnd = new Resistor
    r_ain2_gnd.resistance = 1kohm +/- 1%
    r_ain2_gnd.package = "0603"
    r_ain3_gnd = new Resistor
    r_ain3_gnd.resistance = 1kohm +/- 1%
    r_ain3_gnd.package = "0603"
    adc1.inputs[2].line ~> r_ain2_gnd ~> power.lv
    adc1.inputs[3].line ~> r_ain3_gnd ~> power.lv

    # =====================================================================
    # Multiplexers (3x 74HC4067)
    # =====================================================================
    mux_a = new Nexperia_74HC4067PW_118_package
    mux_b = new Nexperia_74HC4067PW_118_package
    mux_c = new Nexperia_74HC4067PW_118_package

    # Mux power + decoupling
    c_mux_a = new YAGEO_CC0603KRX7R9BB104_package
    c_mux_b = new YAGEO_CC0603KRX7R9BB104_package
    c_mux_c = new YAGEO_CC0603KRX7R9BB104_package

    mux_a.VCC ~ power.hv
    mux_a.GND ~ power.lv
    c_mux_a.p1 ~ power.hv
    c_mux_a.p2 ~ power.lv

    mux_b.VCC ~ power.hv
    mux_b.GND ~ power.lv
    c_mux_b.p1 ~ power.hv
    c_mux_b.p2 ~ power.lv

    mux_c.VCC ~ power.hv
    mux_c.GND ~ power.lv
    c_mux_c.p1 ~ power.hv
    c_mux_c.p2 ~ power.lv

    # Shared select lines (S0-S3)
    mux_s0 ~ mux_a.S0
    mux_s0 ~ mux_b.S0
    mux_s0 ~ mux_c.S0
    mux_s1 ~ mux_a.S1
    mux_s1 ~ mux_b.S1
    mux_s1 ~ mux_c.S1
    mux_s2 ~ mux_a.S2
    mux_s2 ~ mux_b.S2
    mux_s2 ~ mux_c.S2
    mux_s3 ~ mux_a.S3
    mux_s3 ~ mux_b.S3
    mux_s3 ~ mux_c.S3

    # Individual enable lines (~E, active low) with 10k pull-ups (boot-safe: disabled)
    r_en_a = new Resistor
    r_en_a.resistance = 10kohm +/- 1%
    r_en_a.package = "0603"
    r_en_b = new Resistor
    r_en_b.resistance = 10kohm +/- 1%
    r_en_b.package = "0603"
    r_en_c = new Resistor
    r_en_c.resistance = 10kohm +/- 1%
    r_en_c.package = "0603"

    mux_en_a ~ mux_a.nE
    mux_en_a ~> r_en_a ~> power.hv

    mux_en_b ~ mux_b.nE
    mux_en_b ~> r_en_b ~> power.hv

    mux_en_c ~ mux_c.nE
    mux_en_c ~> r_en_c ~> power.hv

    # Mux Z outputs → ADC AIN0 (all three share one ADC input)
    mux_a.Z ~ adc1.inputs[0].line
    mux_b.Z ~ adc1.inputs[0].line
    mux_c.Z ~ adc1.inputs[0].line

    # =====================================================================
    # Excitation filter (R_EXC + C_EXC)
    # =====================================================================
    r_exc = new Resistor
    r_exc.resistance = 270ohm +/- 1%
    r_exc.package = "0603"

    c_exc = new Samsung_Electro_Mechanics_CL10A105KB8NNNC_package
    """1uF. RC = 270 ohm x 1uF = 270us, fc = 589Hz."""

    filtered_exc = new Electrical

    excitation_gpio ~> r_exc ~> filtered_exc
    filtered_exc ~ c_exc.p1
    c_exc.p2 ~ power.lv
    filtered_exc ~ excitation_out

    # Excitation sense → ADC AIN1 (through 1k + 100nF, same as thermistors)
    r_ain_exc = new Resistor
    r_ain_exc.resistance = 1kohm +/- 1%
    r_ain_exc.package = "0603"
    c_ain_exc = new YAGEO_CC0603KRX7R9BB104_package
    prot_exc = new Electrical
    filtered_exc ~> r_ain_exc ~> prot_exc
    prot_exc ~ c_ain_exc.p1
    c_ain_exc.p2 ~ power.lv
    prot_exc ~ adc1.inputs[1].line

    # =====================================================================
    # ESD rail isolation (ferrite bead)
    # =====================================================================
    l_esd = new Sunlord_GZ1608D601TF_package
    """600 ohm @ 100MHz. Isolates TVS transients from clean 3.3V rail."""

    tvs_vcc = new Electrical
    """Dirty 3.3V for TVS arrays only."""

    power.hv ~ l_esd.p1
    l_esd.p2 ~ tvs_vcc

    # Dirty-side decoupling
    c_esd_bulk = new YAGEO_CC0603KRX7R9BB104_package
    tvs_vcc ~ c_esd_bulk.p1
    c_esd_bulk.p2 ~ power.lv

    # =====================================================================
    # TVS arrays (13x PRTR5V0U4D) — powered from dirty rail
    # =====================================================================
    tvs_1 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_2 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_3 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_4 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_5 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_6 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_7 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_8 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_9 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_10 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_11 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_12 = new TECH_PUBLIC_PRTR5V0U4D_TP_package
    tvs_13 = new TECH_PUBLIC_PRTR5V0U4D_TP_package

    # TVS decoupling caps (one per array)
    c_tvs_1 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_2 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_3 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_4 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_5 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_6 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_7 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_8 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_9 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_10 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_11 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_12 = new YAGEO_CC0603KRX7R9BB104_package
    c_tvs_13 = new YAGEO_CC0603KRX7R9BB104_package

    # TVS power wiring (dirty rail)
    tvs_1.VCC ~ tvs_vcc
    tvs_1.GND ~ power.lv
    c_tvs_1.p1 ~ tvs_vcc
    c_tvs_1.p2 ~ power.lv
    tvs_2.VCC ~ tvs_vcc
    tvs_2.GND ~ power.lv
    c_tvs_2.p1 ~ tvs_vcc
    c_tvs_2.p2 ~ power.lv
    tvs_3.VCC ~ tvs_vcc
    tvs_3.GND ~ power.lv
    c_tvs_3.p1 ~ tvs_vcc
    c_tvs_3.p2 ~ power.lv
    tvs_4.VCC ~ tvs_vcc
    tvs_4.GND ~ power.lv
    c_tvs_4.p1 ~ tvs_vcc
    c_tvs_4.p2 ~ power.lv
    tvs_5.VCC ~ tvs_vcc
    tvs_5.GND ~ power.lv
    c_tvs_5.p1 ~ tvs_vcc
    c_tvs_5.p2 ~ power.lv
    tvs_6.VCC ~ tvs_vcc
    tvs_6.GND ~ power.lv
    c_tvs_6.p1 ~ tvs_vcc
    c_tvs_6.p2 ~ power.lv
    tvs_7.VCC ~ tvs_vcc
    tvs_7.GND ~ power.lv
    c_tvs_7.p1 ~ tvs_vcc
    c_tvs_7.p2 ~ power.lv
    tvs_8.VCC ~ tvs_vcc
    tvs_8.GND ~ power.lv
    c_tvs_8.p1 ~ tvs_vcc
    c_tvs_8.p2 ~ power.lv
    tvs_9.VCC ~ tvs_vcc
    tvs_9.GND ~ power.lv
    c_tvs_9.p1 ~ tvs_vcc
    c_tvs_9.p2 ~ power.lv
    tvs_10.VCC ~ tvs_vcc
    tvs_10.GND ~ power.lv
    c_tvs_10.p1 ~ tvs_vcc
    c_tvs_10.p2 ~ power.lv
    tvs_11.VCC ~ tvs_vcc
    tvs_11.GND ~ power.lv
    c_tvs_11.p1 ~ tvs_vcc
    c_tvs_11.p2 ~ power.lv
    tvs_12.VCC ~ tvs_vcc
    tvs_12.GND ~ power.lv
    c_tvs_12.p1 ~ tvs_vcc
    c_tvs_12.p2 ~ power.lv
    tvs_13.VCC ~ tvs_vcc
    tvs_13.GND ~ power.lv
    c_tvs_13.p1 ~ tvs_vcc
    c_tvs_13.p2 ~ power.lv

    # TVS 13 spare channels tied to GND
    tvs_13.ESD2 ~ power.lv
    tvs_13.ESD3 ~ power.lv
    tvs_13.ESD4 ~ power.lv

    # =====================================================================
    # Input protection chains (49x: 1k series R + 100nF shunt C)
    # and mux routing
    #
    # Pattern per channel:
    #   therm_N → tvs_X.ESDY → R_N (1k) → prot_N → C_N (100nF to GND)
    #   prot_N → mux_X.Y_N
    # =====================================================================

    # --- 48 series resistors ---
    r_1 = new Resistor
    r_1.resistance = 1kohm +/- 1%
    r_1.package = "0603"
    r_2 = new Resistor
    r_2.resistance = 1kohm +/- 1%
    r_2.package = "0603"
    r_3 = new Resistor
    r_3.resistance = 1kohm +/- 1%
    r_3.package = "0603"
    r_4 = new Resistor
    r_4.resistance = 1kohm +/- 1%
    r_4.package = "0603"
    r_5 = new Resistor
    r_5.resistance = 1kohm +/- 1%
    r_5.package = "0603"
    r_6 = new Resistor
    r_6.resistance = 1kohm +/- 1%
    r_6.package = "0603"
    r_7 = new Resistor
    r_7.resistance = 1kohm +/- 1%
    r_7.package = "0603"
    r_8 = new Resistor
    r_8.resistance = 1kohm +/- 1%
    r_8.package = "0603"
    r_9 = new Resistor
    r_9.resistance = 1kohm +/- 1%
    r_9.package = "0603"
    r_10 = new Resistor
    r_10.resistance = 1kohm +/- 1%
    r_10.package = "0603"
    r_11 = new Resistor
    r_11.resistance = 1kohm +/- 1%
    r_11.package = "0603"
    r_12 = new Resistor
    r_12.resistance = 1kohm +/- 1%
    r_12.package = "0603"
    r_13 = new Resistor
    r_13.resistance = 1kohm +/- 1%
    r_13.package = "0603"
    r_14 = new Resistor
    r_14.resistance = 1kohm +/- 1%
    r_14.package = "0603"
    r_15 = new Resistor
    r_15.resistance = 1kohm +/- 1%
    r_15.package = "0603"
    r_16 = new Resistor
    r_16.resistance = 1kohm +/- 1%
    r_16.package = "0603"
    r_17 = new Resistor
    r_17.resistance = 1kohm +/- 1%
    r_17.package = "0603"
    r_18 = new Resistor
    r_18.resistance = 1kohm +/- 1%
    r_18.package = "0603"
    r_19 = new Resistor
    r_19.resistance = 1kohm +/- 1%
    r_19.package = "0603"
    r_20 = new Resistor
    r_20.resistance = 1kohm +/- 1%
    r_20.package = "0603"
    r_21 = new Resistor
    r_21.resistance = 1kohm +/- 1%
    r_21.package = "0603"
    r_22 = new Resistor
    r_22.resistance = 1kohm +/- 1%
    r_22.package = "0603"
    r_23 = new Resistor
    r_23.resistance = 1kohm +/- 1%
    r_23.package = "0603"
    r_24 = new Resistor
    r_24.resistance = 1kohm +/- 1%
    r_24.package = "0603"
    r_25 = new Resistor
    r_25.resistance = 1kohm +/- 1%
    r_25.package = "0603"
    r_26 = new Resistor
    r_26.resistance = 1kohm +/- 1%
    r_26.package = "0603"
    r_27 = new Resistor
    r_27.resistance = 1kohm +/- 1%
    r_27.package = "0603"
