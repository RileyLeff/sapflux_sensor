    c_11 = new YAGEO_CC0603KRX7R9BB104_package
    c_12 = new YAGEO_CC0603KRX7R9BB104_package
    c_13 = new YAGEO_CC0603KRX7R9BB104_package
    c_14 = new YAGEO_CC0603KRX7R9BB104_package
    c_15 = new YAGEO_CC0603KRX7R9BB104_package
    c_16 = new YAGEO_CC0603KRX7R9BB104_package
    c_17 = new YAGEO_CC0603KRX7R9BB104_package
    c_18 = new YAGEO_CC0603KRX7R9BB104_package
    c_19 = new YAGEO_CC0603KRX7R9BB104_package
    c_20 = new YAGEO_CC0603KRX7R9BB104_package
    c_21 = new YAGEO_CC0603KRX7R9BB104_package
    c_22 = new YAGEO_CC0603KRX7R9BB104_package
