    r_28.resistance = 1kohm +/- 1%
    r_28.package = "0603"
    r_29 = new Resistor
    r_29.resistance = 1kohm +/- 1%
    r_29.package = "0603"
    r_30 = new Resistor
    r_30.resistance = 1kohm +/- 1%
    r_30.package = "0603"
    r_31 = new Resistor
    r_31.resistance = 1kohm +/- 1%
    r_31.package = "0603"
    r_32 = new Resistor
    r_32.resistance = 1kohm +/- 1%
    r_32.package = "0603"
    r_33 = new Resistor
    r_33.resistance = 1kohm +/- 1%
    r_33.package = "0603"
    r_34 = new Resistor
    r_34.resistance = 1kohm +/- 1%
    r_34.package = "0603"
    r_35 = new Resistor
    r_35.resistance = 1kohm +/- 1%
    r_35.package = "0603"
    r_36 = new Resistor
    r_36.resistance = 1kohm +/- 1%
    r_36.package = "0603"
    r_37 = new Resistor
    r_37.resistance = 1kohm +/- 1%
    r_37.package = "0603"
    r_38 = new Resistor
    r_38.resistance = 1kohm +/- 1%
    r_38.package = "0603"
    r_39 = new Resistor
    r_39.resistance = 1kohm +/- 1%
    r_39.package = "0603"
    r_40 = new Resistor
    r_40.resistance = 1kohm +/- 1%
    r_40.package = "0603"
    r_41 = new Resistor
    r_41.resistance = 1kohm +/- 1%
    r_41.package = "0603"
    r_42 = new Resistor
    r_42.resistance = 1kohm +/- 1%
    r_42.package = "0603"
    r_43 = new Resistor
    r_43.resistance = 1kohm +/- 1%
    r_43.package = "0603"
    r_44 = new Resistor
    r_44.resistance = 1kohm +/- 1%
    r_44.package = "0603"
    r_45 = new Resistor
    r_45.resistance = 1kohm +/- 1%
    r_45.package = "0603"
    r_46 = new Resistor
    r_46.resistance = 1kohm +/- 1%
    r_46.package = "0603"
    r_47 = new Resistor
    r_47.resistance = 1kohm +/- 1%
    r_47.package = "0603"
    r_48 = new Resistor
    r_48.resistance = 1kohm +/- 1%
    r_48.package = "0603"

    # --- 48 filter caps ---
    c_1 = new YAGEO_CC0603KRX7R9BB104_package
    c_2 = new YAGEO_CC0603KRX7R9BB104_package
    c_3 = new YAGEO_CC0603KRX7R9BB104_package
    c_4 = new YAGEO_CC0603KRX7R9BB104_package
    c_5 = new YAGEO_CC0603KRX7R9BB104_package
    c_6 = new YAGEO_CC0603KRX7R9BB104_package
    c_7 = new YAGEO_CC0603KRX7R9BB104_package
    c_8 = new YAGEO_CC0603KRX7R9BB104_package
    c_9 = new YAGEO_CC0603KRX7R9BB104_package
