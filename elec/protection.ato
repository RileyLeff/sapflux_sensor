"""
Input protection: TVS clamp on 24V rail.

v1.1: PTC fuse and Schottky diode moved to main.ato (split between
buck and heater power paths). This module is now TVS-only.

Topology:
  24V rail ──┬── passthrough
             │
           D2 (TVS, cathode to rail, anode to GND)
             │
            GND
"""

import ElectricPower

from "parts/FTR_SMAJ33A/FTR_SMAJ33A.ato" import FTR_SMAJ33A_package

module InputProtection:
    """
    24V input TVS clamp (33V standoff, ~53V clamp).
    Protects against transients on the 24V rail.
    """

    # External interfaces
    power_in = new ElectricPower
    power_out = new ElectricPower

    # D2: TVS clamp, cathode to rail, anode to GND
    d2_tvs = new FTR_SMAJ33A_package
    d2_tvs.C ~ power_in.hv
    d2_tvs.A ~ power_in.lv

    # Passthrough (TVS is shunt, not series)
    power_in.hv ~ power_out.hv
    power_in.lv ~ power_out.lv
