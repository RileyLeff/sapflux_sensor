#pragma experiment("TRAITS")
import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component XINGLIGHT_XL_B1212RGBA_HF_package:
    trait is_atomic_part<manufacturer="XINGLIGHT", partnumber="XL-B1212RGBA-HF", footprint="LED-SMD_4P-L1.2-W1.2_BR.kicad_mod", symbol="XL-B1212RGBA-HF.kicad_sym", model="LED-SMD_4P-L1.2-W1.2_BR.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C22461780", manufacturer="XINGLIGHT", partno="XL-B1212RGBA-HF">
    trait has_designator_prefix<prefix="U">
    trait has_datasheet<datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_2406131539_XINGLIGHT-XL-B1212RGBA-HF_C22461780.pdf">

    # Datasheet pinout: 1=R-, 2=common anode, 3=B-, 4=G-.
    signal A ~ pin 2
    signal R ~ pin 1
    signal G ~ pin 4
    signal B ~ pin 3
