"""
STM32G0B1CBT6 MCU module with power decoupling, BOOT0, NRST, VDDA filtering,
32.768 kHz RTC crystal, and VBAT backup (CR2032).

Power topology:
  3.3V rail -> fb_vdda (600 ohm ferrite bead) -> MCU VDD_VDDA, VREFpos
  VBAT: BAT54C common-cathode diode-OR selects higher of VDDA_FILT or CR2032
  (backup during power loss)
  Bypass caps (4x 100nF) + bulk (1x 1uF) on MCU side of ferrite bead.

Note: LQFP-48 merges VDD and VDDA into one pin (VDD_VDDA). Ferrite bead
filters ALL MCU power. 200mA rating is ample for ~20mA MCU draw.

Crystal: 32.768 kHz (Seiko Epson FC-135R, 12.5pF CL) on PC14/PC15.
  Load caps: 2x 18pF C0G (0402). Stray ~2pF assumed.

BOOT0: 10k pull-down to GND (normal boot from flash).
NRST: 100nF filter cap to GND. Exposed for TPL5010 RSTn connection.

GPIO assignments are made in the top-level module via package pin access.
"""

#pragma experiment("BRIDGE_CONNECT")

import Resistor
import ElectricPower
import Electrical

from "parts/STMicroelectronics_STM32G0B1CBT6/STMicroelectronics_STM32G0B1CBT6.ato" import STMicroelectronics_STM32G0B1CBT6_package
from "parts/Sunlord_GZ1608D601TF/Sunlord_GZ1608D601TF.ato" import Sunlord_GZ1608D601TF_package
from "parts/Samsung_Electro_Mechanics_CL10A105KB8NNNC/Samsung_Electro_Mechanics_CL10A105KB8NNNC.ato" import Samsung_Electro_Mechanics_CL10A105KB8NNNC_package
from "parts/YAGEO_CC0603KRX7R9BB104/YAGEO_CC0603KRX7R9BB104.ato" import YAGEO_CC0603KRX7R9BB104_package
from "parts/Seiko_Epson_Q13FC13500004/Seiko_Epson_Q13FC13500004.ato" import Seiko_Epson_Q13FC13500004_package
from "parts/FH_0402CG180J500NT/FH_0402CG180J500NT.ato" import FH_0402CG180J500NT_package
from "parts/hongjiacheng_BAT54C/hongjiacheng_BAT54C.ato" import hongjiacheng_BAT54C_package
from "parts/Lian_Xin_Technology_BS_CR2032_8/Lian_Xin_Technology_BS_CR2032_8.ato" import Lian_Xin_Technology_BS_CR2032_8_package

module MCU:
    """
    STM32G0B1CBT6 with power filtering, decoupling, BOOT0 pull-down,
    NRST filter cap, 32.768 kHz crystal, and CR2032 VBAT backup.
    """

    # --- External interfaces ---
    power = new ElectricPower
    """3.3V supply rail (from buck converter)."""

    nrst = new Electrical
    """NRST node — exposed for TPL5010 RSTn + SCR latch connection."""

    # --- Package (exposed for GPIO wiring in top-level) ---
    package = new STMicroelectronics_STM32G0B1CBT6_package

    # --- VDDA ferrite bead ---
    fb_vdda = new Sunlord_GZ1608D601TF_package
    """600 ohm @ 100MHz. Filters digital noise from MCU power pins."""

    # --- Internal filtered rail node (named signal for readable net name) ---

    # --- Bulk cap on VDDA (1uF, after ferrite bead) ---
    c_vdda_bulk = new Samsung_Electro_Mechanics_CL10A105KB8NNNC_package

    # --- Bypass caps (4x 100nF, after ferrite bead) ---
    c_bypass_vdd1 = new YAGEO_CC0603KRX7R9BB104_package
    c_bypass_vdd2 = new YAGEO_CC0603KRX7R9BB104_package
    c_bypass_vdd3 = new YAGEO_CC0603KRX7R9BB104_package
    c_bypass_vdd4 = new YAGEO_CC0603KRX7R9BB104_package

    # --- NRST filter cap ---
    c_nrst = new YAGEO_CC0603KRX7R9BB104_package

    # --- BOOT0 pull-down ---
    r_boot0 = new Resistor
    r_boot0.resistance = 10kohm +/- 1%
    r_boot0.package = "0603"

    # --- 32.768 kHz Crystal ---
    crystal = new Seiko_Epson_Q13FC13500004_package
    c_xtal_in = new FH_0402CG180J500NT_package   # 18pF load cap on OSC32_IN
    c_xtal_out = new FH_0402CG180J500NT_package   # 18pF load cap on OSC32_OUT

    # --- VBAT backup ---
    bat54c = new hongjiacheng_BAT54C_package
    cr2032 = new Lian_Xin_Technology_BS_CR2032_8_package
    c_vbat_decouple = new YAGEO_CC0603KRX7R9BB104_package     # 100nF VBAT decoupling
    c_vbat_bulk = new Samsung_Electro_Mechanics_CL10A105KB8NNNC_package  # 1uF VBAT bulk

    # === Power path: 3.3V -> ferrite bead -> MCU pins ===
    power.hv ~ fb_vdda.p1
    signal VDDA_FILT ~ fb_vdda.p2
    VDDA_FILT.override_net_name = "VDDA_FILT"

    # MCU power pins (all on filtered side, except VBAT)
    VDDA_FILT ~ package.VDD_VDDA
    VDDA_FILT ~ package.VREFpos
    power.lv ~ package.VSS_VSSA

    # === VBAT backup circuit ===
    # BAT54C common-cathode diode-OR:
    # A1/A2 = sources, K = VBAT output. Higher voltage source wins.
    bat54c.A1 ~ VDDA_FILT
    bat54c.A2 ~ cr2032.POS
    bat54c.K ~ package.VBAT
    cr2032.NEG ~ power.lv

    # VBAT decoupling (100nF + 1uF near pin)
    bat54c.K ~ c_vbat_decouple.p1
    c_vbat_decouple.p2 ~ power.lv
    bat54c.K ~ c_vbat_bulk.p1
    c_vbat_bulk.p2 ~ power.lv

    # === Bypass caps (after ferrite bead) ===
    VDDA_FILT ~ c_bypass_vdd1.p1
    c_bypass_vdd1.p2 ~ power.lv

    VDDA_FILT ~ c_bypass_vdd2.p1
    c_bypass_vdd2.p2 ~ power.lv

    VDDA_FILT ~ c_bypass_vdd3.p1
    c_bypass_vdd3.p2 ~ power.lv

    VDDA_FILT ~ c_bypass_vdd4.p1
    c_bypass_vdd4.p2 ~ power.lv

    # === VDDA bulk cap (after ferrite bead) ===
    VDDA_FILT ~ c_vdda_bulk.p1
    c_vdda_bulk.p2 ~ power.lv

    # === NRST ===
    package.PF2_NRST ~ nrst
    nrst ~ c_nrst.p1
    c_nrst.p2 ~ power.lv

    # === BOOT0 pull-down ===
    signal BOOT0 ~ package.PA14_BOOT0
    BOOT0 ~> r_boot0 ~> power.lv

    # === 32.768 kHz Crystal ===
    # Crystal between PC14_OSC32_IN and PC15_OSC32_OUT
    crystal.p1 ~ package.PC14_OSC32_IN
    crystal.p2 ~ package.PC15_OSC32_OUT

    # Load caps: 18pF C0G from each crystal pin to GND
    c_xtal_in.p1 ~ package.PC14_OSC32_IN
    c_xtal_in.p2 ~ power.lv
    c_xtal_out.p1 ~ package.PC15_OSC32_OUT
    c_xtal_out.p2 ~ power.lv
