"""
Heater driver + TPL5010 watchdog + SCR latch safety circuit.

v1.1 changes:
  - Q1: TM15N10D (DPAK, 100V/15A) replaces XCHS3N12 (SOT-23, 120V/3A)
  - Gate driver: Q_CTRL + Q_DRIVER + D_ZENER (10V) boosts gate to 10V
    from 24V rail. Non-inverted logic (PA8 HIGH = heater ON).
  - Flyback: SS56 replaces SS36 (5A vs 3A, handles 8-heater inrush)
  - Fuse clips: 2x 5x20mm clips in heater power path (user-supplied fuse)
  - Old R_GATE (1k) and R4 (10k gate pulldown) removed — gate driver
    replaces both functions.

Gate driver circuit:
  V24 ── R_GATE_PULL (1M) ──┬── Q_HEATER Gate ── D_ZENER (10V) ── GND
                             │
                        Q_DRIVER drain (source to GND)

  Q_DRIVER gate: V24 ── R_BIAS (4.7M) ──┬── R_GATE_PD (1M) ── GND
                                          │
                                     Q_CTRL drain (source to GND)

  Q_CTRL gate: PA8 ── R_CTRL (10k) ──┬── R_CTRL_PD (100k) ── GND

PA8 HIGH → Q_CTRL ON → Q_DRIVER gate LOW → Q_DRIVER OFF →
R_GATE_PULL charges Q_HEATER gate to 10V (zener clamp) → heater ON.

SCR latch circuit (unchanged from v1.0):
  TPL5010 RSTn → D_ISO → R_BASE → Q2_INV (PNP)
  Q2_INV collector → Q_WD gate (gate clamp) + R_FB → Q_ARM → Q_LATCH base
  Q_LATCH collector → Q2_INV base (cross-coupled latch)
  PGOOD → R_ARM → C_ARM (arm delay prevents POR latch trigger)
"""

#pragma experiment("BRIDGE_CONNECT")

import Resistor
import ElectricPower
import Electrical

from "parts/Tritech_MOS_TM15N10D/Tritech_MOS_TM15N10D.ato" import Tritech_MOS_TM15N10D_package
from "parts/hongjiacheng_SS56/hongjiacheng_SS56.ato" import hongjiacheng_SS56_package
from "parts/hongjiacheng_MM3Z10/hongjiacheng_MM3Z10.ato" import hongjiacheng_MM3Z10_package
from "parts/Xucheng_Elec_5x20/Xucheng_Elec_5x20.ato" import Xucheng_Elec_5x20_package
from "parts/Texas_Instruments_TPL5010DDCR/Texas_Instruments_TPL5010DDCR.ato" import Texas_Instruments_TPL5010DDCR_package
from "parts/Changjiang_Electronics_Tech_SS8550_Y2_RANGE_200_350/Changjiang_Electronics_Tech_SS8550_Y2_RANGE_200_350.ato" import Changjiang_Electronics_Tech_SS8550_Y2_RANGE_200_350_package
from "parts/Changjiang_Electronics_Tech_2N7002/Changjiang_Electronics_Tech_2N7002.ato" import Changjiang_Electronics_Tech_2N7002_package
from "parts/Changjiang_Electronics_Tech_1N4148WS/Changjiang_Electronics_Tech_1N4148WS.ato" import Changjiang_Electronics_Tech_1N4148WS_package
from "parts/Changjiang_Electronics_Tech_MMBT3904_RANGE_100_300/Changjiang_Electronics_Tech_MMBT3904_RANGE_100_300.ato" import Changjiang_Electronics_Tech_MMBT3904_RANGE_100_300_package
from "parts/Honor_Elec_VP1H101M0607/Honor_Elec_VP1H101M0607.ato" import Honor_Elec_VP1H101M0607_package
from "parts/YAGEO_CC0603KRX7R9BB104/YAGEO_CC0603KRX7R9BB104.ato" import YAGEO_CC0603KRX7R9BB104_package
from "parts/Samsung_Electro_Mechanics_CL10A105KB8NNNC/Samsung_Electro_Mechanics_CL10A105KB8NNNC.ato" import Samsung_Electro_Mechanics_CL10A105KB8NNNC_package
from "parts/UNI_ROYAL_0603WAF4704T5E/UNI_ROYAL_0603WAF4704T5E.ato" import UNI_ROYAL_0603WAF4704T5E_package
from "parts/Murata_Electronics_GRM21BR61H106KE43L/Murata_Electronics_GRM21BR61H106KE43L.ato" import Murata_Electronics_GRM21BR61H106KE43L_package

module HeaterDriver:
    """
    24V heater driver with gate driver (10V from 24V), TM15N10D DPAK MOSFET,
    fuse clips, TPL5010 watchdog, and SCR latch safety.
    """

    # --- External interfaces ---
    power_24v = new ElectricPower
    """24V rail (post-TVS V24_RAW). Fuse and gate driver draw from here."""

    power_3v3 = new ElectricPower
    """3.3V rail (watchdog, PNP emitter, pull-ups)."""

    heater_hi = new Electrical
    """Heater positive terminal (to 2-pin connector)."""

    heater_lo = new Electrical
    """Heater negative terminal (to 2-pin connector, connects to Q_HEATER drain)."""

    gate_drive = new Electrical
    """MCU timer output PA8 (into Q_CTRL gate via R_CTRL)."""

    wake = new Electrical
    """TPL5010 WAKE output → MCU EXTI input."""

    done = new Electrical
    """TPL5010 DONE input ← MCU GPIO output."""

    rstn = new Electrical
    """TPL5010 RSTn node. Also connects to MCU NRST."""

    pgood = new Electrical
    """PGOOD signal from buck converter. Gates latch arming."""

    # --- Power MOSFET (TM15N10D, DPAK) ---
    q_heater = new Tritech_MOS_TM15N10D_package
    """100V/15A N-FET heater switch. 75 mΩ @ Vgs=10V."""

    # --- Flyback diode (SS56, 5A SMA) ---
    d_flyback = new hongjiacheng_SS56_package
    """60V/5A flyback Schottky across heater."""

    # --- Fuse clips (2x, hold 5x20mm glass fuse) ---
    fuse_clip_1 = new Xucheng_Elec_5x20_package
    fuse_clip_2 = new Xucheng_Elec_5x20_package

    # --- Bulk decoupling on 24V ---
    c_bulk_24v = new Honor_Elec_VP1H101M0607_package
    """100uF 50V electrolytic. Absorbs heater switching transients."""

    c_bulk_cer_1 = new Murata_Electronics_GRM21BR61H106KE43L_package
    c_bulk_cer_2 = new Murata_Electronics_GRM21BR61H106KE43L_package
    """2x 10uF 50V ceramic (0805). Low-ESR bypass for 5A switching transients."""

    # --- Gate driver components ---
    q_driver = new Changjiang_Electronics_Tech_2N7002_package
    """N-FET gate clamp stage. Biased by 24V divider."""

    q_ctrl = new Changjiang_Electronics_Tech_2N7002_package
    """N-FET MCU isolation. PA8 controls Q_DRIVER indirectly."""

    d_zener = new hongjiacheng_MM3Z10_package
    """10V zener. Clamps Q1 gate voltage to safe 10V level."""

    r_gate_pull = new Resistor
    r_gate_pull.resistance = 1Mohm +/- 1%
    r_gate_pull.package = "0603"
    """Pulls Q1 gate toward 24V when Q_DRIVER is OFF."""

    r_bias = new UNI_ROYAL_0603WAF4704T5E_package
    """4.7M resistor. 24V divider upper leg for Q_DRIVER gate bias."""

    r_gate_pd = new Resistor
    r_gate_pd.resistance = 1Mohm +/- 1%
    r_gate_pd.package = "0603"
    """24V divider lower leg for Q_DRIVER gate. V_gate = 24 * 1M/5.7M = 4.2V."""

    r_ctrl = new Resistor
    r_ctrl.resistance = 10kohm +/- 1%
    r_ctrl.package = "0603"
    """Series resistor between PA8 and Q_CTRL gate."""

    r_ctrl_pd = new Resistor
    r_ctrl_pd.resistance = 100kohm +/- 1%
    r_ctrl_pd.package = "0603"
    """Q_CTRL gate pull-down. Boot-safe: keeps Q_CTRL OFF when PA8 floats."""

    # --- TPL5010 watchdog ---
    u_wdt = new Texas_Instruments_TPL5010DDCR_package
    c_wd = new YAGEO_CC0603KRX7R9BB104_package

    r_delay = new Resistor
    r_delay.resistance = 11kohm +/- 1%
    r_delay.package = "0603"

    r_done_pd = new Resistor
    r_done_pd.resistance = 100kohm +/- 1%
    r_done_pd.package = "0603"

    # --- SCR latch components (unchanged from v1.0) ---
    q2_inv = new Changjiang_Electronics_Tech_SS8550_Y2_RANGE_200_350_package
    q_wd = new Changjiang_Electronics_Tech_2N7002_package
    q_latch = new Changjiang_Electronics_Tech_MMBT3904_RANGE_100_300_package
    d_iso = new Changjiang_Electronics_Tech_1N4148WS_package

    r_base = new Resistor
    r_base.resistance = 10kohm +/- 1%
    r_base.package = "0603"
    r_wd_pd = new Resistor
    r_wd_pd.resistance = 10kohm +/- 1%
    r_wd_pd.package = "0603"
    r_wd_pu = new Resistor
    r_wd_pu.resistance = 100kohm +/- 1%
    r_wd_pu.package = "0603"
    r_fb = new Resistor
    r_fb.resistance = 100kohm +/- 1%
    r_fb.package = "0603"
    r_latch_pd = new Resistor
    r_latch_pd.resistance = 1Mohm +/- 1%
    r_latch_pd.package = "0603"
    r_pnp_base = new Resistor
    r_pnp_base.resistance = 100kohm +/- 1%
    r_pnp_base.package = "0603"

    # --- PGOOD-gated latch arm circuit ---
    q_arm = new Changjiang_Electronics_Tech_2N7002_package
    r_arm = new Resistor
    r_arm.resistance = 1Mohm +/- 1%
    r_arm.package = "0603"
    c_arm = new Samsung_Electro_Mechanics_CL10A105KB8NNNC_package

    # --- Internal nodes ---
    gate_node = new Electrical
    """Q_HEATER gate: R_GATE_PULL, D_ZENER cathode, Q_DRIVER drain, Q_WD drain."""

    driver_gate_node = new Electrical
    """Q_DRIVER gate: R_BIAS bottom, R_GATE_PD top, Q_CTRL drain."""

    ctrl_gate_node = new Electrical
    """Q_CTRL gate: R_CTRL output, R_CTRL_PD top."""

    fused_24v = new Electrical
    """Post-fuse 24V node for heater path."""

    pnp_coll_node = new Electrical
    pnp_base_node = new Electrical
    d_iso_anode_node = new Electrical
    fb_out_node = new Electrical
    latch_base_node = new Electrical
    arm_node = new Electrical

    # =====================================================================
    # Heater power path (with fuse)
    # =====================================================================

    # V24 → fuse_clip_1 → [physical fuse] → fuse_clip_2 → fused_24v
    power_24v.hv ~ fuse_clip_1.p1
    fuse_clip_2.p1 ~ fused_24v

    # Fused 24V → heater_hi, heater_lo → Q_HEATER → GND
    fused_24v ~ heater_hi
    heater_lo ~ q_heater.D
    q_heater.S ~ power_24v.lv

    # Flyback diode across heater
    d_flyback.A ~ heater_lo
    d_flyback.K ~ fused_24v

    # Bulk cap on 24V rail (before fuse, on main rail)
    power_24v.hv ~ c_bulk_24v.p1
    c_bulk_24v.p2 ~ power_24v.lv

    # Low-ESR ceramic bypass caps (handle 5A step transient, ~5mΩ ESR)
    power_24v.hv ~ c_bulk_cer_1.1
    c_bulk_cer_1.2 ~ power_24v.lv
    power_24v.hv ~ c_bulk_cer_2.1
    c_bulk_cer_2.2 ~ power_24v.lv

    # =====================================================================
    # Gate driver circuit
    # =====================================================================

    # R_GATE_PULL: 24V → 1M → gate_node (charges Q_HEATER gate when Q_DRIVER OFF)
    power_24v.hv ~> r_gate_pull ~> gate_node

    # D_ZENER: clamps gate_node to 10V (cathode at gate, anode to GND)
    d_zener.K ~ gate_node
    d_zener.A ~ power_24v.lv

    # Q_DRIVER: drain at gate_node, source to GND (pulls gate LOW when ON)
    q_driver.D ~ gate_node
    q_driver.S ~ power_24v.lv

    # Q_DRIVER gate bias: 24V divider (R_BIAS 4.7M / R_GATE_PD 1M)
    r_bias.p1 ~ power_24v.hv
    r_bias.p2 ~ driver_gate_node
    driver_gate_node ~> r_gate_pd ~> power_24v.lv
    driver_gate_node ~ q_driver.G

    # Q_CTRL: drain pulls driver_gate_node to GND (overrides divider bias)
    q_ctrl.D ~ driver_gate_node
    q_ctrl.S ~ power_24v.lv

    # Q_CTRL gate: PA8 → R_CTRL → ctrl_gate_node → R_CTRL_PD → GND
    gate_drive ~> r_ctrl ~> ctrl_gate_node
    ctrl_gate_node ~> r_ctrl_pd ~> power_24v.lv
    ctrl_gate_node ~ q_ctrl.G

    # Q_HEATER gate connection
    gate_node ~ q_heater.G

    # Q_WD (latch kill) clamps gate to GND on fault
    q_wd.D ~ gate_node
    q_wd.S ~ power_24v.lv

    # =====================================================================
    # TPL5010 watchdog (unchanged from v1.0)
    # =====================================================================
    u_wdt.VDD ~ power_3v3.hv
    u_wdt.GND ~ power_3v3.lv
    power_3v3.hv ~ c_wd.p1
    c_wd.p2 ~ power_3v3.lv

    # Timeout resistor (11k → ~9.6s period)
    u_wdt.DELAY_M_RST ~> r_delay ~> power_3v3.lv

    # MCU interface
    u_wdt.WAKE ~ wake
    u_wdt.DONE ~ done
    done ~> r_done_pd ~> power_3v3.lv

    # RSTn with pull-up
    u_wdt.RSTn ~ rstn
    rstn ~> r_wd_pu ~> power_3v3.hv

    # =====================================================================
    # SCR latch circuit (unchanged from v1.0)
    # =====================================================================

    # PNP inverter (Q2_INV): emitter → 3.3V
    q2_inv.E ~ power_3v3.hv
    q2_inv.B ~ pnp_base_node
    q2_inv.C ~ pnp_coll_node

    # PNP collector drives Q_WD gate + feedback
    pnp_coll_node ~ q_wd.G
    pnp_coll_node ~> r_wd_pd ~> power_3v3.lv
    pnp_coll_node ~> r_fb ~> fb_out_node

    # Q_ARM gates feedback path
    q_arm.D ~ fb_out_node
    q_arm.S ~ latch_base_node
    q_arm.G ~ arm_node

    # D_ISO: cathode at RSTn, anode → R_BASE → PNP base
    d_iso.K ~ rstn
    d_iso.A ~ d_iso_anode_node
    d_iso_anode_node ~> r_base ~> pnp_base_node

    # NPN latch: collector → PNP base node, emitter → GND
    q_latch.C ~ pnp_base_node
    q_latch.E ~ power_3v3.lv
    q_latch.B ~ latch_base_node

    # PNP base-emitter pull-up
    pnp_base_node ~> r_pnp_base ~> power_3v3.hv

    # =====================================================================
    # PGOOD-gated latch arm (unchanged from v1.0)
    # =====================================================================
    pgood ~> r_arm ~> arm_node
    arm_node ~ c_arm.p1
    c_arm.p2 ~ power_3v3.lv

    # Latch base pull-down
    latch_base_node ~> r_latch_pd ~> power_3v3.lv
